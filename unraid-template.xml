<?xml version="1.0"?>
<Container version="2">
  <Name>NordVPN-FRITZBox-Generator</Name>
  <Repository>ghcr.io/techsuchti/nordvpn-fritzbox-config-generator:1.1.3</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Techsuchti/NordVPN-fritzbox-config-generator</Support>
  <Project>https://github.com/Techsuchti/NordVPN-fritzbox-config-generator</Project>
  <Overview>Lokaler NordVPN WireGuard Konfigurationsgenerator mit FRITZ!Box-kompatibler Ausgabe, lokaler Anmeldung und verschlüsselter Access-Token-Speicherung.</Overview>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/Techsuchti/NordVPN-fritzbox-config-generator/main/docker/icon.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <Config Name="WebUI" Target="8080" Default="8080" Mode="tcp" Description="Port der Weboberfläche" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="AppData" Target="/data" Default="/mnt/user/appdata/NordVPN-FRITZBox-Generator" Mode="rw" Description="Lokale Datenbank, Sessions und verschlüsselter Access Token" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/NordVPN-FRITZBox-Generator</Config>
</Container>
