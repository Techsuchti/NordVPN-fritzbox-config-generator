<?xml version="1.0"?>
<Container version="2">
  <Name>NordVPN-FRITZBox-Generator</Name>
  <Repository>ghcr.io/techsuchti/nordvpn-fritzbox-config-generator:1.0.1</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Techsuchti/NordVPN-fritzbox-config-generator</Support>
  <Project>https://github.com/Techsuchti/NordVPN-fritzbox-config-generator</Project>
  <Overview>NordVPN WireGuard Konfigurationsgenerator mit FRITZ!Box-kompatibler Ausgabe. Die Weboberfläche läuft lokal; der API-Zugriff wird sicher an den konfigurierten NordGen-Worker weitergeleitet.</Overview>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/Techsuchti/NordVPN-fritzbox-config-generator/main/docker/icon.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <Config Name="WebUI" Target="8080" Default="8080" Mode="tcp" Description="Port der Weboberfläche" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
</Container>
